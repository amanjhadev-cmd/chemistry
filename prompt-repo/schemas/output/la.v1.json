{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-repo/schemas/output/la.v1.json",
  "title": "LA Draft Questions Output (AI Call 1)",
  "type": "object",
  "required": ["drafts"],
  "additionalProperties": false,
  "properties": {
    "drafts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "draft_question_id", "question", "answer", "explanation",
          "source_section_ids", "source_pages"
        ],
        "additionalProperties": false,
        "properties": {
          "draft_question_id": { "type": "string", "pattern": "^draft_[A-Z0-9_]+_[0-9]{4}$" },
          "question": { "type": "string", "minLength": 10 },
          "options": { "type": "null" },
          "answer": { "type": "string", "minLength": 50 },
          "explanation": { "type": "string", "minLength": 10 },
          "topic": { "type": "string" },
          "subtopic": { "type": "string" },
          "bloom_level": {
            "type": "string",
            "enum": ["understand", "apply", "analyze", "evaluate", "create"]
          },
          "marks": { "type": "integer", "minimum": 3, "maximum": 10 },
          "source_section_ids": { "type": "array", "items": { "type": "string" } },
          "source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "visual_required": { "type": "boolean" },
          "visual_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
