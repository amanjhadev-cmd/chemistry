{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-repo/schemas/output/mcq.v2.json",
  "title": "MCQ Draft Questions Output (AI Call 1)",
  "type": "object",
  "required": ["drafts"],
  "additionalProperties": false,
  "properties": {
    "drafts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "draft_question_id", "question", "options", "answer",
          "explanation", "source_section_ids", "source_pages"
        ],
        "additionalProperties": false,
        "properties": {
          "draft_question_id": { "type": "string", "pattern": "^draft_[A-Z0-9_]+_[0-9]{4}$" },
          "question": { "type": "string", "minLength": 5 },
          "options": {
            "type": "object",
            "required": ["A", "B", "C", "D"],
            "additionalProperties": false,
            "properties": {
              "A": { "type": "string", "minLength": 1 },
              "B": { "type": "string", "minLength": 1 },
              "C": { "type": "string", "minLength": 1 },
              "D": { "type": "string", "minLength": 1 }
            }
          },
          "answer": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "explanation": { "type": "string", "minLength": 5 },
          "topic": { "type": "string" },
          "subtopic": { "type": "string" },
          "bloom_level": {
            "type": "string",
            "enum": ["remember", "understand", "apply", "analyze", "evaluate", "create"]
          },
          "source_section_ids": { "type": "array", "items": { "type": "string" } },
          "source_pages": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "visual_required": { "type": "boolean" },
          "visual_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
