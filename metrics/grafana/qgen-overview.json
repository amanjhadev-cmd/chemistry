{
  "title": "Question Generation v1.0 — Overview",
  "uid": "qgen-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["qgen"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "AI cost (last 24h)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "qgen_ai_cost_usd_last_24h_usd" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 } }
    },
    {
      "id": 2, "type": "stat", "title": "Batches (last 24h)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "qgen_ai_cost_usd_last_24h_batches" }]
    },
    {
      "id": 3, "type": "stat", "title": "Good ratio (last 24h)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "qgen_good_ratio_last_24h_ratio" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "green", "value": 0.6 }
      ] } } }
    },
    {
      "id": 4, "type": "stat", "title": "AI budget divergence",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "qgen_ai_call_budget_divergence_divergence" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Tokens / minute by call",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "rate(qgen_ai_tokens_total_total{ordinal=\"generator\",direction=\"input\"}[5m])",  "legendFormat": "gen in"  },
        { "expr": "rate(qgen_ai_tokens_total_total{ordinal=\"generator\",direction=\"output\"}[5m])", "legendFormat": "gen out" },
        { "expr": "rate(qgen_ai_tokens_total_total{ordinal=\"validator\",direction=\"input\"}[5m])", "legendFormat": "val in"  },
        { "expr": "rate(qgen_ai_tokens_total_total{ordinal=\"validator\",direction=\"output\"}[5m])","legendFormat": "val out" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Questions in last 24h, by bucket",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [{ "expr": "qgen_questions_bucket_last_24h_total", "legendFormat": "{{bucket}}" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Errors per hour",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "targets": [{ "expr": "rate(qgen_error_audit_total_total[1h]) * 3600", "legendFormat": "{{error_code}}" }]
    },
    {
      "id": 8, "type": "timeseries", "title": "Shortfall batches (24h)",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "targets": [{ "expr": "qgen_shortfall_batches_last_24h_total" }]
    },
    {
      "id": 9, "type": "stat", "title": "Coverage gaps (cells with <5 good)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "targets": [{ "expr": "qgen_coverage_gaps_total_total" }]
    },
    {
      "id": 10, "type": "table", "title": "Questions by board (good / upgrade / bad)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        { "expr": "qgen_coverage_total_questions_good",    "format": "table", "instant": true, "legendFormat": "{{board}}" },
        { "expr": "qgen_coverage_total_questions_upgrade", "format": "table", "instant": true, "legendFormat": "{{board}}" },
        { "expr": "qgen_coverage_total_questions_bad",     "format": "table", "instant": true, "legendFormat": "{{board}}" }
      ]
    },
    {
      "id": 11, "type": "stat", "title": "Dedup signal coverage (simhash %)",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 28 },
      "targets": [{ "expr": "qgen_dedup_signals_populated_pct_simhash_pct" }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }
      ] } } }
    },
    {
      "id": 12, "type": "stat", "title": "KB cache rows",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 28 },
      "targets": [{ "expr": "qgen_kb_cache_rows" }]
    },
    {
      "id": 13, "type": "stat", "title": "Avg KB extraction quality",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 28 },
      "targets": [{ "expr": "qgen_kb_cache_avg_quality" }],
      "fieldConfig": { "defaults": { "max": 1, "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null }, { "color": "yellow", "value": 0.4 }, { "color": "green", "value": 0.7 }
      ] } } }
    }
  ]
}
