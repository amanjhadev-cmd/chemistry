{
  "platform": {
    "name": "Chemistry Question Generation Platform",
    "phase": 1,
    "phase_name": "Knowledge Extraction",
    "schema_version": "1.0.0",
    "owner": "team@nextleap.ai"
  },
  "defaults": {
    "board": "CBSE",
    "language": "English",
    "number_of_questions": 10,
    "include_visual_questions": false,
    "generate_explanation": true
  },
  "supported": {
    "boards": ["CBSE"],
    "classes": ["Class XI", "Class XII"],
    "source_types": ["NCERT", "Reference Book", "Teacher Notes", "PYQ Collection", "Mixed"],
    "question_types": ["MCQ", "VSA", "SA", "LA", "AR", "CASE_STUDY"],
    "difficulties": ["EASY", "MEDIUM", "HARD"],
    "languages": ["English"]
  },
  "chapters": {
    "Class XI": [
      "Some Basic Concepts of Chemistry",
      "Structure of Atom",
      "Classification of Elements and Periodicity in Properties",
      "Chemical Bonding and Molecular Structure",
      "Thermodynamics",
      "Equilibrium",
      "Redox Reactions",
      "Organic Chemistry - Some Basic Principles and Techniques",
      "Hydrocarbons"
    ],
    "Class XII": [
      "Solutions",
      "Electrochemistry",
      "Chemical Kinetics",
      "The d- and f-Block Elements",
      "Coordination Compounds",
      "Haloalkanes and Haloarenes",
      "Alcohols, Phenols and Ethers",
      "Aldehydes, Ketones and Carboxylic Acids",
      "Amines",
      "Biomolecules"
    ]
  },
  "ai": {
    "structurer_model": "claude-haiku-4-5-20251001",
    "structurer_temperature": 0,
    "structurer_max_tokens": 8000,
    "structurer_max_tries": 2,
    "structurer_wait_between_tries_ms": 3000
  },
  "drive": {
    "root_folder": "Question Bank",
    "knowledge_subfolder": "Knowledge Base",
    "filename_pattern": "{CHAPTER_CODE}_KNOWLEDGE.json"
  },
  "future_phases": {
    "phase_2": "Prompt routing + AI question generation (consumes the Phase 1 JSON)",
    "phase_3": "Validator pass (per-question 9-check verdict)",
    "phase_4": "Duplicate detection + regeneration loop",
    "phase_5": "Per-(type x difficulty) question-bank Drive storage"
  }
}
